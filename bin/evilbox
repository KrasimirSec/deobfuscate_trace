#!/bin/sh
# Run Evilbox from this repo. Creates .venv on first use. No activate needed.
set -e
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
VENV="$ROOT/.venv"
PY="$VENV/bin/python"
if [ ! -x "$PY" ]; then
  echo "evilbox: creating local environment (once)..." >&2
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q -e "$ROOT"
fi
exec "$PY" -m evilbox "$@"
